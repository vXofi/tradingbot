# Copy this file to .env and fill in your values
# cp .env.example .env

# Required — Tinkoff Invest API sandbox token
# Get at: https://www.tinkoff.ru/invest/ → Settings → Tokens → Sandbox
TOKEN_TINKOFF=t.your_token_here

# Optional — Google Gemini API key (free tier: Flash / Flash-Lite only)
# Get at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSy...
# Legacy gemini-2.0-* excluded — free tier often limit=0. Override if needed:
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional — use sandbox mode (default: true)
# Set to false only for live production trading
USE_SANDBOX=true
