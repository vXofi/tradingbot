# Copy this file to .env and fill in your values
# cp .env.example .env

# Required — Tinkoff Invest API sandbox token
# Get at: https://www.tinkoff.ru/invest/ → Settings → Tokens → Sandbox
TOKEN_TINKOFF=t.your_token_here

# Optional — Google Gemini API key (free tier: 60 req/min)
# Get at: https://aistudio.google.com/apikey
# If not set, LLM fallback in news parsing is disabled
# GEMINI_API_KEY=AIzaSy...

# Optional — use sandbox mode (default: true)
# Set to false only for live production trading
USE_SANDBOX=true
